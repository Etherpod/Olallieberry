{
  "$schema": "https://raw.githubusercontent.com/Outer-Wilds-New-Horizons/new-horizons/main/NewHorizons/Schemas/body_schema.json",
  "name": "The Ephemeris",
  "starSystem": "SolarSystem",
  "canShowOnTitle": false,

  "Base": {
    "showMinimap": false,
    "surfaceSize": 600
  },

  "Orbit": {
    "isStatic": true,
    "staticPosition": {
      "x": 0,
      "y": 6250, // the sun's radius is 2000m
      "z": 0
    },
    "siderealPeriod": 0
  },

  "ReferenceFrame": {
    "enabled": true,
    "bracketRadius": 300,
    "targetColliderRadius": 400
  },

  "MapMarker": {
    "enabled": true
  },

  "AmbientLights": [
    {
      "innerRadius": 500,
      "outerRadius": 600,
      "intensity": 0.5,
      "tint": {
        "r": 255,
        "g": 210,
        "b": 100
      }
    }
  ],

  "ShipLog": {
    "xmlFile": "assets/shiplog/Ephemeris.xml",
    "spriteFolder": "assets/shiplog/images",
    "mapMode": {
      "scale": 0.6,
      "invisibleWhenHidden": true,
      "manualNavigationPosition": {
        "x": 4.0
      },
      "manualPosition": {
        "x": 1500.0,
        "y": -90.0
      },
      "revealedSprite": "assets/shiplog/images/EphemerisMapMode.png"
    }
  },

  "Volumes": {
    "revealVolumes": [
      {
        "radius": 600,
        "revealOn": "enter",
        "revealFor": "both",
        "reveals": [
          "OLALLIEBERRY_EPHEMERIS_FOUND"
        ]
      }
    ],
    "creditsVolume": [
      {
        "radius": 600,
        "parentPath": "Sector/Ending",
        "gameOver": {
          "colour": {
            "r": 255,
            "g": 210,
            "b": 100
          },
          "condition": "OLALLIEBERRY_WAKE_VYSS",
          "creditsType": "custom",
          "text": "The Vyss awaken to see what remains.",
          "audio": "assets/audio/olallieberry_ambience.ogg",
          "audioVolume": 0.75,
          "audioLooping": true,
          "length": 120
        }
      }
    ]
  },

